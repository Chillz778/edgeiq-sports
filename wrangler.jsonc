{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edgeiq-sports",
  "main": "backend/worker.py",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
